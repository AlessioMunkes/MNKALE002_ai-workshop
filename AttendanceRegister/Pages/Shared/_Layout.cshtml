@using Microsoft.Extensions.Options
@inject IOptions<BrandingOptions> Branding
@{
    var role = User.IsInRole("Lecturer") ? "Lecturer" : User.IsInRole("Student") ? "Student" : null;

    // The help button is driven entirely by the catalogue, so a page gains one
    // by gaining an entry rather than by adding markup.
    var pageKey = ViewContext.RouteData.Values["page"] as string;
    var pageHelp = PageHelpCatalogue.For(pageKey);
}
<!DOCTYPE html>
<html lang="en-ZA">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0e4d64" />

    @* Set before the stylesheet applies, so blocks that are about to be revealed
       on scroll are never painted first and then hidden again. *@
    <script>document.documentElement.classList.add('has-js');</script>
    <title>@ViewData["Title"] &middot; INF3003W Attendance Register</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet"
          href="https://fonts.googleapis.com/css2?family=Lato:ital,wght@0,300;0,400;0,700;0,900;1,400&family=Montserrat:wght@500;600;700&display=swap" />

    <link rel="icon" href="@Url.Content("~" + Branding.Value.LogoPath)" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<a class="skip-link" href="#main">Skip to content</a>

<header class="masthead">
    <div class="shell masthead__inner">
        <a class="wordmark" asp-page="/Index">
            <partial name="_Logo" model="@("mast")" />
            <span class="wordmark__text">
                <span class="wordmark__code">INF3003W</span>
                <span class="wordmark__name">Attendance Register</span>
            </span>
        </a>

        <nav class="nav" aria-label="Main">
            @if (role == "Student")
            {
                <a class="nav__link" asp-page="/Student/Index">Dashboard</a>
                <a class="nav__link" asp-page="/Student/History">My attendance</a>
                <a class="nav__link" asp-page="/Student/Queries">Queries</a>
            }
            else if (role == "Lecturer")
            {
                <a class="nav__link" asp-page="/Lecturer/Index">Overview</a>
                <a class="nav__link" asp-page="/Lecturer/Students">Class list</a>
                <a class="nav__link" asp-page="/Lecturer/Sessions">Sessions</a>
                <a class="nav__link" asp-page="/Lecturer/Import">Upload register</a>
                <a class="nav__link" asp-page="/Lecturer/Queries">Queries</a>
            }
            <a class="nav__link" asp-page="/Help">Help</a>
        </nav>

        <div class="account">
            @if (pageHelp is not null)
            {
                <button type="button" class="help-button" data-help-open
                        aria-haspopup="dialog" aria-label="About this page" title="About this page">?</button>
            }

            @if (User.Identity?.IsAuthenticated == true)
            {
                <span class="account__name">@(User.Identity?.Name)</span>
                <span class="badge badge--role">@role</span>
                <form method="post" asp-page="/Account/Logout" class="account__form">
                    <button type="submit" class="btn btn--ghost btn--sm">Sign out</button>
                </form>
            }
            else
            {
                <a class="btn btn--sm" asp-page="/Account/Login">Sign in</a>
            }
        </div>
    </div>
</header>

<main id="main" class="shell main">
    <partial name="_StatusMessage" />
    @RenderBody()
</main>

<footer class="footer">
    <div class="shell footer__inner">
        <span class="footer__brand">
            <partial name="_Logo" model="@("footer")" />
            University of Cape Town &middot; Department of Information Systems
        </span>
        <a asp-page="/Help">How this works</a>
    </div>
</footer>

@if (pageHelp is not null)
{
    <dialog id="page-help" class="help-dialog" aria-labelledby="page-help-title">
        <div class="help-dialog__body">
            <p class="eyebrow">About this page</p>
            <h2 class="help-dialog__title" id="page-help-title">@pageHelp.Title</h2>
            @foreach (var paragraph in pageHelp.Paragraphs)
            {
                <p>@paragraph</p>
            }
            <div class="help-dialog__actions">
                <a class="link" asp-page="/Help">Full help</a>
                <button type="button" class="btn btn--sm" data-help-close autofocus>Got it</button>
            </div>
        </div>
    </dialog>
}

<script src="~/js/reveal.js" asp-append-version="true" defer></script>
<script src="~/js/password-toggle.js" asp-append-version="true" defer></script>
<script src="~/js/checkin-pulse.js" asp-append-version="true" defer></script>
<script src="~/js/count-up.js" asp-append-version="true" defer></script>
<script src="~/js/confirm-delete.js" asp-append-version="true" defer></script>
<script src="~/js/table-tools.js" asp-append-version="true" defer></script>
<script src="~/js/page-help.js" asp-append-version="true" defer></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
